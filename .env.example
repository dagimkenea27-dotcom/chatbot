# ============================================================
# GojoShop.et Chatbot - Environment Configuration Template
# ============================================================
# Copy this to .env and fill in your actual values.

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-me
PORT=5000

# --- MySQL / XAMPP ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gojoshop

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- Twilio (WhatsApp / SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_DB=0
SESSION_TTL=3600

# --- Shop Config ---
SHOP_NAME=GojoShop.et
SHOP_SUPPORT_EMAIL=support@gojoshop.et
SHOP_SUPPORT_PHONE=
SHOP_SUPPORT_HOURS=Mon-Sat, 9:00 AM - 6:00 PM EAT
